# Non-secret runtime settings for Haven. Rendered to /etc/haven/haven.env by apply.sh.
# Secrets (JWT_SECRET, VAPID_*) live in the app's own /var/lib/haven/.env, sourced from sops.
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
FORCE_HTTP=true
PUBLIC_URL=https://haven.reverb256.dev
ADMIN_USERNAME=reverb256
