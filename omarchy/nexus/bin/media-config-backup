#!/usr/bin/env bash
# Back up the arr config tier (media-config) to garage S3 — CONSISTENTLY.
#
# Managed by homelab-ops/omarchy/nexus — installed to /usr/local/bin and driven
# by media-config-backup.timer.
#
# WHY STAGING EXISTS (learned the hard way, 2026-09-22):
# A direct `aws s3 sync` of this directory never completes. The arr configs are
# LIVE SQLite databases that the running arr containers keep writing, and the
# AWS CLI computes an object checksum and THEN streams the file. If the file
# changes in between, garage rejects it:
#
#   400 Bad Request, Invalid digest: Failed to validate checksum for algorithm
#   Crc32: calculated Some(Crc32([49,132,81,210])),
#            expected Crc32([200,173,192,163])
#
# Every such file fails and is retried forever, which pins the sync at roughly
# one object per minute against a 20k-object source, and hammers the disk while
# it does so. The fix is not a bigger timeout: a live SQLite file cannot be
# uploaded consistently at all. Stage a consistent copy first.
#
#   - rsync everything EXCEPT the database files, their -wal/-shm sidecars,
#     and regenerable caches (.cache, __pycache__, fontconfig caches). Caches
#     are most of the 22k file count and none of the value.
#   - for every source *.db, take an ONLINE consistent snapshot with sqlite3's
#     backup API (mode=ro) rather than copying bytes under the writer.
#   - sync only the staged tree, which is quiescent, so checksums always match.
#
# Credentials come from garage via the local admin socket: no secrets on disk,
# and it survives key rotation (the 2026-09-20 rotation silently broke zephyr's
# static rclone remote with a 403).
set -euo pipefail

SRC=/data/nvme1/media-config
BUCKET=media-config
# garage.toml sets api_bind_addr = "100.76.105.73:3900" — the S3 API listens
# ONLY on the tailnet address. 127.0.0.1:3900 does not answer, so verifying
# against loopback reports "could not connect" and looks like a broken backup
# when the sync is healthy. Always verify against THIS url.
ENDPOINT=http://100.76.105.73:3900
KEYNAME=media-config-backup
STAMP=$(date +%Y%m%d-%H%M%S)
RETAIN=14
# Stage on the SSD tier, never /tmp: /tmp is the LUKS root and the staged copy
# is a few GB. /data/fast has ~464G free and is otherwise idle.
STAGE_BASE=/data/fast/backup-stage

command -v aws >/dev/null 2>&1 || { echo "aws cli missing" >&2; exit 2; }
command -v sqlite3 >/dev/null 2>&1 || { echo "sqlite3 missing (needed for consistent db snapshots)" >&2; exit 2; }
[[ -d "$SRC" ]] || { echo "source $SRC missing — is the 240G mounted?" >&2; exit 2; }

# Refuse to back up an empty store: that is the signature of the 240G failing to
# mount, and syncing it would report success while destroying the backup set.
if [[ -z "$(find "$SRC" -type f -print -quit)" ]]; then
  echo "source $SRC is EMPTY — refusing to sync (240G not mounted?)" >&2
  exit 2
fi

info=$(garage -c /etc/garage.toml key info "$KEYNAME" --show-secret 2>/dev/null)
AWS_ACCESS_KEY_ID=$(printf '%s\n' "$info" | sed -n 's/^Key ID:[[:space:]]*//p')
AWS_SECRET_ACCESS_KEY=$(printf '%s\n' "$info" | sed -n 's/^Secret key:[[:space:]]*//p')
[[ -n "$AWS_ACCESS_KEY_ID" && -n "$AWS_SECRET_ACCESS_KEY" ]] \
  || { echo "could not read $KEYNAME credentials from garage" >&2; exit 2; }
export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
export AWS_DEFAULT_REGION=garage
export AWS_RETRY_MODE=standard AWS_MAX_ATTEMPTS=8
export AWS_EC2_METADATA_DISABLED=true

# Serialize uploads modestly. media-config is 20k SMALL files, so concurrency
# hides per-request latency that one connection cannot — but keep it sane so the
# S3 handler is not starved, since garage's data sits on bcache0, which the
# monthly scrub also reads.
AWS_CFG=$(mktemp)
cat > "$AWS_CFG" <<'CFG'
[default]
s3 =
  max_concurrent_requests = 8
  max_bandwidth = 200MB/s
  use_accelerate_endpoint = false
  multipart_threshold = 64MB
  multipart_chunksize = 16MB
CFG
export AWS_CONFIG_FILE="$AWS_CFG"

STAGE="$STAGE_BASE/$STAMP"
mkdir -p "$STAGE"
cleanup() { rm -f "$AWS_CFG"; rm -rf "$STAGE"; }
trap cleanup EXIT

echo "staging a consistent copy of $SRC -> $STAGE"

# 1. everything except live db files, their sidecars, and regenerable caches.
#    --db exclude patterns must not swallow the ./db-config style dirs, which is
#    why they are anchored on the file suffix.
rsync -a --delete \
  --exclude '*.db' --exclude '*.db-wal' --exclude '*.db-shm' \
  --exclude '*.sqlite' --exclude '*.sqlite-wal' --exclude '*.sqlite-shm' \
  --exclude '.cache/' --exclude '__pycache__/' --exclude '*.pyc' \
  --exclude 'cache/' --exclude 'transcodes/' --exclude 'logs/' \
  "$SRC/" "$STAGE/"

# 2. consistent online snapshots of every SQLite database. sqlite3's .backup
#    uses the online backup API, so it is safe against a live writer, unlike a
#    byte copy. mode=ro so a snapshot can never mutate the live database.
n_db=0
while IFS= read -r -d '' db; do
  rel="${db#$SRC/}"
  mkdir -p "$STAGE/$(dirname "$rel")"
  if sqlite3 -readonly "file:$db?mode=ro" ".backup '$STAGE/$rel'" 2>/dev/null; then
    n_db=$((n_db + 1))
  else
    # A database that cannot be snapshotted must not silently vanish from the
    # backup — say so and keep the rest.
    echo "WARN: could not snapshot $rel (left out)" >&2
  fi
done < <(find "$SRC" \( -name '*.db' -o -name '*.sqlite' \) -type f -print0)
echo "  snapshotted $n_db database(s); staged $(find "$STAGE" -type f | wc -l) file(s)"

sync_with_retry() {
  local src="$1" dst="$2" attempt sleep_s
  # 8 attempts was too few. The monthly btrfs scrub saturates bcache0 (100% util,
  # r_await ~360ms) and garage's data lives on that device, so PUTs intermittently
  # 503. The 04:30 run burned all 8 retries and exited non-zero *after* uploading
  # most objects, so the snapshot copy, verify and prune never ran. 30 attempts
  # with a gentler ramp ride out a scrub pass instead of failing the night.
  for attempt in $(seq 1 30); do
    if aws --endpoint-url "$ENDPOINT" s3 sync "$src" "$dst" \
        --only-show-errors --no-progress \
        --cli-connect-timeout 60 --cli-read-timeout 300; then
      return 0
    fi
    sleep_s=$(( attempt < 6 ? attempt * 15 : 90 ))
    echo "WARN: sync attempt $attempt failed ($src -> $dst); retrying in ${sleep_s}s" >&2
    sleep "$sleep_s"
  done
  return 1
}

sync_with_retry "$STAGE" "s3://$BUCKET/current/"
sync_with_retry "$STAGE" "s3://$BUCKET/snapshots/$STAMP/"

# Verify by OBJECT COUNT against the staged file count, never by exit code.
staged=$(find "$STAGE" -type f | wc -l)
n=$(aws --endpoint-url "$ENDPOINT" s3 ls "s3://$BUCKET/current/" --recursive | wc -l)
[[ "$n" -gt 0 ]] || { echo "backup verified EMPTY — failing" >&2; exit 1; }
echo "media-config backup ok: $n objects in current/ (staged $staged), snapshot $STAMP"

# Prune old snapshots, keeping the most recent $RETAIN.
mapfile -t snaps < <(aws --endpoint-url "$ENDPOINT" s3 ls "s3://$BUCKET/snapshots/" \
  | awk '{print $2}' | tr -d '/' | sort)
count=${#snaps[@]}
if (( count > RETAIN )); then
  for s in "${snaps[@]:0:$((count - RETAIN))}"; do
    aws --endpoint-url "$ENDPOINT" s3 rm "s3://$BUCKET/snapshots/$s/" --recursive --only-show-errors
    echo "pruned snapshot $s"
  done
fi
