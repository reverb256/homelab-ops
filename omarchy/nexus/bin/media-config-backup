#!/usr/bin/env bash
# Back up the arr config tier (media-config) to garage S3.
#
# Managed by homelab-ops/omarchy/nexus — installed by apply.sh to
# /usr/local/bin/media-config-backup and driven by media-config-backup.timer.
#
# WHY: these are live SQLite databases (radarr/sonarr/prowlarr/jellyfin/etc)
# holding library metadata, indexer config and torrent queue state. They live on
# /dev/nvme1n1 — a 240G Kingston labelled "nexus-cache" that is at 96% of its
# RATED WRITE ENDURANCE, holds ~95GB of non-regenerable data, and has no
# snapshot, no replica and (until this script) no backup anywhere.
#
# Credentials come from garage itself via the local admin socket, so this needs
# no sops and no secret files on disk — and it survives key rotation, which is
# exactly how the zephyr rclone remote silently broke on 2026-09-20.
set -euo pipefail

SRC=/data/nvme1/media-config
BUCKET=media-config
# garage.toml sets `api_bind_addr = "100.76.105.73:3900"` — the S3 API listens
# ONLY on the tailnet address. 127.0.0.1:3900 does not answer, so verifying with
# a loopback endpoint reports "Could not connect" and looks like a broken
# backup when the sync is actually healthy. Verify against THIS url.
ENDPOINT=http://100.76.105.73:3900
KEYNAME=media-config-backup
STAMP=$(date +%Y%m%d-%H%M%S)
RETAIN=14

command -v aws >/dev/null 2>&1 || { echo "aws cli missing" >&2; exit 2; }
[[ -d "$SRC" ]] || { echo "source $SRC missing — is the 240G mounted?" >&2; exit 2; }

# Refuse to back up an empty store. That is the signature of the 240G failing to
# mount, and syncing it would report success while destroying the backup set.
if [[ -z "$(find "$SRC" -type f -print -quit)" ]]; then
  echo "source $SRC is EMPTY — refusing to sync (240G not mounted?)" >&2
  exit 2
fi

info=$(garage -c /etc/garage.toml key info "$KEYNAME" --show-secret 2>/dev/null)
AWS_ACCESS_KEY_ID=$(printf '%s\n' "$info" | sed -n 's/^Key ID:[[:space:]]*//p')
AWS_SECRET_ACCESS_KEY=$(printf '%s\n' "$info" | sed -n 's/^Secret key:[[:space:]]*//p')
[[ -n "$AWS_ACCESS_KEY_ID" && -n "$AWS_SECRET_ACCESS_KEY" ]] \
  || { echo "could not read $KEYNAME credentials from garage" >&2; exit 2; }
export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
export AWS_DEFAULT_REGION=garage
export AWS_RETRY_MODE=standard AWS_MAX_ATTEMPTS=8
export AWS_EC2_METADATA_DISABLED=true

# --- IO-pressure tuning (same rationale as memlawb-backup) ---
# bcache0 is ~88% full with btrfs csum errors; peakminer + qbittorrent saturate
# the same disks. Serialize uploads and cap bandwidth so garage's S3 handler is
# not starved, and widen timeouts so one stalled object does not abort the sync.
AWS_CFG=$(mktemp)
cat > "$AWS_CFG" <<'CFG'
[default]
s3 =
  max_concurrent_requests = 1
  max_bandwidth = 64MB/s
  use_accelerate_endpoint = false
  multipart_threshold = 64MB
  multipart_chunksize = 16MB
CFG
export AWS_CONFIG_FILE="$AWS_CFG"
trap 'rm -f "$AWS_CFG"' EXIT

# NOTE ON CONSISTENCY: the arr apps are running, so this is a LIVE copy of
# SQLite databases. Each DB is synced together with its -wal and -shm, which is
# the recoverable combination, but a write landing mid-copy can still yield a DB
# that needs its WAL replayed. That is acceptable for a disaster-recovery point;
# it is NOT a substitute for the quiesced copy taken during the planned move of
# this tier off the worn drive. If a restore is needed, restore the WHOLE
# directory, never a single .db in isolation.
sync_with_retry() {
  local src="$1" dst="$2" attempt sleep_s
  for attempt in 1 2 3 4 5 6 7 8; do
    if aws --endpoint-url "$ENDPOINT" s3 sync "$src" "$dst" \
        --only-show-errors \
        --no-progress \
        --cli-connect-timeout 60 \
        --cli-read-timeout 300; then
      return 0
    fi
    sleep_s=$((attempt * 30))
    echo "WARN: sync attempt $attempt failed ($src -> $dst); retrying in ${sleep_s}s" >&2
    sleep "$sleep_s"
  done
  return 1
}

sync_with_retry "$SRC" "s3://$BUCKET/current/"
sync_with_retry "$SRC" "s3://$BUCKET/snapshots/$STAMP/"

# Verify by OBJECT COUNT, never by exit code.
n=$(aws --endpoint-url "$ENDPOINT" s3 ls "s3://$BUCKET/current/" --recursive | wc -l)
[[ "$n" -gt 0 ]] || { echo "backup verified EMPTY — failing" >&2; exit 1; }
echo "media-config backup ok: $n objects in current/, snapshot $STAMP"

# Prune old snapshots, keeping the most recent $RETAIN.
mapfile -t snaps < <(aws --endpoint-url "$ENDPOINT" s3 ls "s3://$BUCKET/snapshots/" \
  | awk '{print $2}' | tr -d '/' | sort)
count=${#snaps[@]}
if (( count > RETAIN )); then
  for s in "${snaps[@]:0:$((count - RETAIN))}"; do
    aws --endpoint-url "$ENDPOINT" s3 rm "s3://$BUCKET/snapshots/$s/" --recursive --only-show-errors
    echo "pruned snapshot $s"
  done
fi
