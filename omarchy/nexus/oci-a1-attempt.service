[Unit]
Description=Attempt to claim the Always Free Ampere A1 (2 OCPU / 12 GB) in ca-toronto-1
Documentation=file:/home/j_kro/.oci/README-handoff.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=j_kro
Group=j_kro
Environment=HOME=/home/j_kro
Environment=OCI_CLI_CONFIG_FILE=/home/j_kro/.oci/config
ExecStart=/usr/bin/flock -n /home/j_kro/.oci/attempt.lock /usr/local/bin/oci-a1-attempt
TimeoutStartSec=3000
