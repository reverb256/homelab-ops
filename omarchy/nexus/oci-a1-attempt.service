[Unit]
Description=Attempt to claim the Always Free Ampere A1 (2 OCPU / 12 GB) in ca-toronto-1
Documentation=file:/home/j_kro/.oci/README-handoff.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/flock -n /run/oci-a1-attempt.lock /usr/local/bin/oci-a1-attempt
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=3000
