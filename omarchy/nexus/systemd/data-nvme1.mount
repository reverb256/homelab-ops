# Managed by homelab-ops/omarchy/nexus — do not hand-edit on the host.
#
# /data/nvme1 content tier. EVACUATED on 2026-09-22 off the 240G Kingston
# nvme1n1 (SA1000M8240G, 96% wear) onto the @nvme1 subvolume of the root NVMe
# (WDC SN550, 10% wear). The Kingston still holds a frozen copy for rollback
# and is pending physical removal — What= deliberately points at the ROOT
# filesystem UUID, so nvme1n1 must NOT be remounted here. Old device UUID for
# reference (do not use): 51f28a54-2a7d-4fa1-aa16-2c38c1eb9a0b
[Unit]
Description=/data/nvme1 (arr config + stampede + jellyfin cache tier; on root @nvme1 since 2026-09-22)
Documentation=https://github.com/reverb256/homelab-ops

[Mount]
What=/dev/disk/by-uuid/5e992e10-8c9c-4392-bfd5-55db5e36d6ac
Where=/data/nvme1
Type=btrfs
Options=defaults,noatime,compress=zstd:3,subvol=/@nvme1

[Install]
WantedBy=local-fs.target
