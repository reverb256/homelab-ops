# Managed by homelab-ops/omarchy/nexus — do not hand-edit on the host.
# Applied by apply.sh. Edit the repo copy, commit, re-apply.
#
# nexus-storage: Hermes agent data
#
# The underlying device is /dev/bcache0, assembled from /dev/sda (backing) +
# /dev/sdb (cache) by udev/69-bcache.rules. It is addressed by btrfs UUID so a
# device-name change cannot mismatch the mount.
#
# nofail + a device timeout keep a pool failure from blocking boot: the mount
# is skipped and dependent services (garage) fail instead of the whole host.

[Unit]
Description=nexus-storage: Hermes agent data
Documentation=https://github.com/reverb256/homelab-ops
DefaultDependencies=no
Before=local-fs.target
After=blockdev@dev-bcache0.target

[Mount]
What=/dev/disk/by-uuid/08cbb21c-adb0-4e3c-928f-7b6d1fa2d236
Where=/data/hermes
Type=btrfs
Options=subvol=hermes,compress=zstd,ssd,discard=async,nofail,x-systemd.device-timeout=30s

[Install]
WantedBy=local-fs.target
