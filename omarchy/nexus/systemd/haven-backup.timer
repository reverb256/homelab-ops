# /etc/systemd/system/haven-backup.timer
# Managed by homelab-ops/omarchy/nexus — do not hand-edit on the host.
#
# Daily at 04:20 (after memlawb-backup at 04:00). Persistent=true so a missed
# run (host off) fires on next boot rather than silently skipping a day.

[Unit]
Description=Daily Haven backup to garage S3

[Timer]
OnCalendar=*-*-* 04:20:00
Persistent=true
RandomizedDelaySec=10m
Unit=haven-backup.service

[Install]
WantedBy=timers.target
