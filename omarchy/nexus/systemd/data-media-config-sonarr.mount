# Managed by homelab-ops/omarchy/nexus — do not hand-edit on the host.
#
# Bind the sonarr config from the 240G tier into the path the arr app mounts.
# Declared in git so the bind is reproducible; it lived only in /etc/fstab,
# while eight sibling /data mounts were already unit-managed.
[Unit]
Description=Bind /data/media/config/sonarr <- /data/nvme1/media-config/sonarr
Documentation=https://github.com/reverb256/homelab-ops
RequiresMountsFor=/data/nvme1
After=data-nvme1.mount

[Mount]
What=/data/nvme1/media-config/sonarr
Where=/data/media/config/sonarr
Type=none
Options=bind

[Install]
WantedBy=local-fs.target
