# /etc/systemd/system/gitlawb-backup.timer
# Managed by homelab-ops/omarchy/sentry — do not hand-edit on the host.
#
# Daily at 04:30 (after the 04:00 memlawb run on nexus). Persistent=true so a
# missed run (host off) fires on next boot rather than silently skipping a day.
[Unit]
Description=Daily gitlawb backup to nexus (~/backups/gitlawb)

[Timer]
OnCalendar=*-*-* 04:30:00
Persistent=true
RandomizedDelaySec=15m
Unit=gitlawb-backup.service

[Install]
WantedBy=timers.target
