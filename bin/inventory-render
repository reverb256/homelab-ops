#!/usr/bin/env python3
"""Render docs/ARCHITECTURE-MAP.md from inventory/*.yaml.

Usage: bin/inventory-render [--check]
  --check  exit 1 if the committed map differs from a fresh render (CI gate).
"""
import pathlib
import sys

import yaml

ROOT = pathlib.Path(__file__).resolve().parent.parent


def load(rel):
    return yaml.safe_load((ROOT / rel).read_text())


def table(headers, rows):
    out = ["| " + " | ".join(headers) + " |",
           "|" + "|".join("---" for _ in headers) + "|"]
    out += ["| " + " | ".join(str(c) for c in row) + " |" for row in rows]
    return "\n".join(out)


def render() -> str:
    inv = load("inventory/inventory.yaml")
    svc = load("inventory/services.yaml")
    k = svc["kubernetes"]
    net = inv["network"]
    P = []

    P.append("<!-- GENERATED by bin/inventory-render - edit inventory/*.yaml, not this file -->")
    P.append(f"# Homelab architecture map\n")
    P.append(f"_Inventory updated: {inv['updated']}_\n")

    P.append("## Hosts\n")
    rows = []
    for name, h in sorted(inv["hosts"].items()):
        rows.append([name, h.get("ip", "-"), net["tailnet"]["devices"].get(name, "-"),
                     h.get("os", "-"), h.get("role", "-"),
                     ", ".join(h.get("gpus", [])) or "-"])
    P.append(table(["Host", "LAN", "Tailnet", "OS", "Role", "GPUs"], rows))

    P.append("\n## Devices\n")
    rows = [[n, d.get("ip", "-"), net["tailnet"]["devices"].get(n, "-"),
             d.get("os", "-"), d.get("role", "-")]
            for n, d in sorted(inv["devices"].items())]
    P.append(table(["Device", "LAN", "Tailnet", "OS", "Role"], rows))

    P.append("\n## Network\n")
    lan = net["lan"]
    P.append(f"- LAN `{lan['cidr']}` gw `{lan['gateway']}` | DNS VIP `{lan['dns_vip']}` | "
             f"DNS `{lan['dns']}` | IPv6 `{lan['ipv6']}`")
    tk = net["k8s"]
    P.append(f"- Tailnet `{net['tailnet']['cidr']}`")
    P.append(f"- k3s ({tk['distro']}, {tk['cni']}): services `{tk['service_cidr']}`, "
             f"pods `{tk['pod_cidr']}`; CP {', '.join(k['control_plane'])}; "
             f"agents {', '.join(k['agents'])}")

    ns = k["namespaces"]
    deny = sorted(n for n, v in ns.items() if v.get("isolation") == "default-deny")
    wave2 = sorted(n for n, v in ns.items() if v.get("netpol_plan") == "wave-2")
    P.append("\n## Kubernetes namespaces\n")
    rows = [[n, v.get("purpose", "-"),
             ", ".join(v.get("exposure", [])) or "-", v.get("isolation", "-")]
            for n, v in sorted(ns.items())]
    P.append(table(["Namespace", "Purpose", "Exposure", "Isolation"], rows))
    P.append(f"\n**Isolation posture:** {len(deny)} of {len(ns)} namespaces default-deny "
             f"({', '.join(deny) or 'none'}); wave-2 queued: {', '.join(wave2) or 'none'}.")

    P.append("\n## Exposure flow\n")
    P.append("```mermaid\nflowchart LR")
    P.append("  CF[Cloudflare edge]")
    P.append("  LAN[LAN 10.1.1.0/24]")
    P.append("  TS[Tailnet 100.64.0.0/10]")
    for n, v in sorted(ns.items()):
        exp = v.get("exposure", [])
        if "cloudflare-tunnel" in exp:
            P.append(f"  CF -->|tunnel| {n}[{n}]")
        if "lan-proxy" in exp and n != "media-reverse-proxy":
            P.append(f"  LAN -->|nginx-rp| {n}[{n}]")
        if "lan" in exp and n not in ("argocd", "longhorn-system"):
            P.append(f"  LAN -->|{n}.lan| {n}[{n}]")
        if "tailscale" in exp:
            P.append(f"  TS --> {n}[{n}]")
    P.append("```")

    P.append("\n## Source-of-truth boundaries\n")
    P.append("- Secrets: Bitwarden Secrets Manager / sops - never in this repo")
    P.append("- .lan DNS: `omarchy/nexus/unbound/local-dns.conf`")
    P.append("- Service configs: their repos (media-k8s, mining-k8s, quill, astral-key, ...)")
    P.append("- This map: regenerate with `bin/inventory-render`; CI gates drift")
    return "\n".join(P) + "\n"


if __name__ == "__main__":
    text = render()
    out = ROOT / "docs/ARCHITECTURE-MAP.md"
    if "--check" in sys.argv:
        current = out.read_text() if out.exists() else ""
        if current != text:
            print("DRIFT: docs/ARCHITECTURE-MAP.md is stale - run bin/inventory-render",
                  file=sys.stderr)
            sys.exit(1)
        print("architecture map is up to date")
    else:
        out.write_text(text)
        print(f"wrote {out.relative_to(ROOT)}")
